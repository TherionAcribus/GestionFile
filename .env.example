# =============================================================================
# GestionFile - Variables d'environnement
# =============================================================================
# Copiez ce fichier en .env et remplissez les valeurs selon votre environnement.
#   cp .env.example .env
# =============================================================================

# --- Mode / Environnement ---
# Type de base de données : mysql ou sqlite
DATABASE_TYPE=mysql
# Environnement : prod, dev, aws
SITE=prod
# Mode debug Flask (1 = activé, 0 = désactivé)
FLASK_DEBUG=0
# Port d'écoute (les PaaS injectent PORT automatiquement)
PORT=5000
# docker-compose.coolify.yaml est une stack TOUT-EN-UN : mysql + rabbitmq +
# init + web + scheduler, sans variable de profil à régler.
# Role du processus applicatif:
# - all (defaut): web + scheduler + bootstrap
# - web: web only, scheduler en pause (safe pour multi-worker)
# - scheduler: scheduler actif + bootstrap
# - init: bootstrap uniquement puis exit
APP_ROLE=all
# Pages activées dans l'éditeur visuel mutualisé (announce, patient, phone).
# La V1 active uniquement Annonce ; ajouter les autres après validation métier.
PAGE_EDITOR_ENABLED_PAGES=announce

# --- Base de données ---
# Option 1 : URL complète (prioritaire, recommandé pour PaaS type Render/Coolify)
# DATABASE_URL=mysql+pymysql://user:password@host/dbname
# DATABASE_URL_SCHEDULER=mysql+pymysql://user:password@host/scheduler_dbname
#
# Option 2 : Variables séparées (fallback si DATABASE_URL n'est pas défini)
# Mot de passe root MySQL (utilisé uniquement par docker-compose pour initialiser le serveur)
MYSQL_ROOT_PASSWORD=change-me
# Utilisateur applicatif (non-root recommandé en production)
# En Docker Compose, l'image MySQL crée cet utilisateur automatiquement
# avec tous les droits sur MYSQL_DATABASE uniquement.
MYSQL_USER=gestionfile
MYSQL_PASSWORD=change-me
MYSQL_HOST=localhost
MYSQL_DATABASE=queuedatabase

# Base MySQL pour APScheduler (jobstore)
# Par defaut: meme base que MYSQL_DATABASE
# MYSQL_SCHEDULER_DATABASE=queuedatabase

# --- Sécurité ---
# Clé secrète Flask (générée automatiquement si absente)
# SECRET_KEY=
# Sel pour le hachage des mots de passe (généré automatiquement si absent)
# SECURITY_PASSWORD_SALT=
# Secret partagé pour l'authentification des applications (route /api/get_app_token).
# OBLIGATOIRE : le serveur refuse de démarrer si absent, vide ou laissé au
# placeholder ci-dessous. Mettez une valeur forte et unique, identique au secret
# saisi côté clients (App comptoir, imprimante, borne).
APP_SECRET=changez_moi
# Tests de performance administrables. Laisser disabled tant qu'un environnement
# de preproduction n'est pas pret. La cible est configuree ici, jamais dans l'UI.
STRESS_TEST_MODE=disabled
# STRESS_TARGET_URL=http://web:5000
# Secret interne distinct d'APP_SECRET (32 caracteres minimum).
# STRESS_RUNNER_SECRET=
# Marque les cookies de session et « se souvenir de moi » avec l'attribut
# Secure (HTTPS uniquement). À activer IMPÉRATIVEMENT dès que le site est
# servi en TLS (reverse proxy, PaaS) ; laisser vide en HTTP local sinon le
# navigateur refuserait les cookies. Défaut 1 dans docker-compose.coolify.yaml.
# COOKIE_SECURE=1

# --- Premier administrateur ---
# Créés uniquement à l'amorçage d'une base vide (aucun utilisateur existant).
# ADMIN_INITIAL_PASSWORD est OBLIGATOIRE en déploiement Coolify ; sans lui,
# un mot de passe aléatoire est généré et affiché une fois dans les logs
# du conteneur init. Le mot de passe doit respecter la politique interne
# (>= 10 caractères, non trivial, différent du nom d'utilisateur).
# ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=

# --- Chiffrement ---
# Clé Fernet (32 octets encodés en base64 url-safe) pour chiffrer les clés
# de service stockées en base (ex. clé Google TTS). Génération locale :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BASE32_KEY=

# --- RabbitMQ ---
# URL de connexion AMQP complète (prioritaire si renseignée).
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
# Si RABBITMQ_URL est vide, l'URL est construite depuis ces variables
# (utilisé par docker-compose.coolify.yaml où le mot de passe est généré) :
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_USER=
# RABBITMQ_PASSWORD=

# --- Socket.IO ---
# Origines CORS autorisées (vide = désactivé, * = tout en debug, ou liste séparée par des virgules)
# SOCKETIO_CORS_ALLOWED_ORIGINS=

# --- Spotify (musique d'ambiance, optionnel) ---
# Identifiant et secret de VOTRE application Spotify (dashboard developer Spotify).
# Prioritaires sur la configuration stockée en base (music_spotify_user /
# music_spotify_key). À privilégier : le secret n'apparaît alors ni en base ni
# dans les sauvegardes. Ne JAMAIS commiter de valeur réelle ici.
# IMPORTANT : aucun secret Spotify n'est fourni par défaut. Si un ancien secret
# codé en dur a existé, il doit être révoqué puis régénéré dans le dashboard
# Spotify avant réutilisation.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
